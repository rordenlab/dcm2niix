{
  "name": "@niivue/dcm2niix",
  "version": "1.4.20261029",
  "description": "Run Chris Rorden's dcm2niix (WebAssembly) in the browser to convert DICOM to NIfTI with no upload.",
  "type": "module",
  "main": "dist/index.jpeg.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.jpeg.js"
    },
    "./jpeg": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.jpeg.js"
    },
    "./plain": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.jpeg.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "LICENSE",
    "NOTICES"
  ],
  "scripts": {
    "test": "node test/unit.mjs && node test/browser.mjs",
    "test:consumer": "node test/consumer.mjs",
    "build": "node esbuild.config.cjs",
    "makeWasmJpeg": "JPEGLS=1 make wasm-jpeg -C ../console",
    "fixWasmJsJpeg": "node scripts/pre-build.cjs -i src/dcm2niix.jpeg.js -o src/dcm2niix.jpeg.js",
    "prebuild": "npm run makeWasmJpeg && npm run fixWasmJsJpeg",
    "check-dist": "node scripts/check-dist.mjs",
    "prepack": "npm run check-dist",
    "demo": "npm run build && npx http-server .",
    "demo-no-build": "npx http-server ."
  },
  "keywords": [
    "niivue",
    "dcm2niix",
    "nifti",
    "dicom",
    "medical",
    "imaging",
    "conversion",
    "wasm"
  ],
  "author": "dcm2niix developers",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.61.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.5"
  }
}
